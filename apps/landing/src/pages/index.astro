  <footer class="footer">
    <div class="wrap">
      <div class="foot-grid">
        <div class="foot-brand">
          <a class="logo" href="#"><img class="logo-mark" src="/sentezy-logo.png" alt="Sentezy" />Sentezy</a>
          <p data-tr="Fikirleri konuşan videoya sentezleyin.">Synthesize ideas into talking video.</p>
          <div class="switch">
            <button class="sw-btn" data-switch="tr">TR</button>
            <button class="sw-btn on" data-switch="en">EN</button>
          </div>
        </div>
        <div class="foot-col"><h4 data-tr="Ürün">Product</h4><a href="#" data-tr="Platform">Platform</a><a href="#" data-tr="Avatarlar">Avatars</a><a href="#" data-tr="Çeviri">Translation</a><a href="#">AI Studio</a><a href="#" data-tr="Fiyatlandırma">Pricing</a></div>
        <div class="foot-col"><h4 data-tr="Çözümler">Solutions</h4><a href="#" data-tr="Pazarlama">Marketing</a><a href="#" data-tr="Eğitim">Training</a><a href="#" data-tr="Satış">Sales</a><a href="#" data-tr="Yerelleştirme">Localization</a></div>
        <div class="foot-col"><h4 data-tr="Kaynaklar">Resources</h4><a href="#">Blog</a><a href="#" data-tr="Rehberler">Guides</a><a href="#" data-tr="Şablonlar">Templates</a><a href="#" data-tr="Destek">Support</a></div>
        <div class="foot-col"><h4 data-tr="Yasal">Legal</h4><a href="#">KVKK</a><a href="#" data-tr="Gizlilik">Privacy</a><a href="#" data-tr="Şartlar">Terms</a></div>
      </div>
      <div class="foot-bottom"><span>© 2026 Sentezy</span><span data-tr="Türkiye'de tasarlandı">Made for teams worldwide</span></div>
    </div>
