---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Base>
  <Nav />

  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy reveal">
        <div class="eyebrow" data-tr="YAPAY ZEKA VİDEO STÜDYOSU">AI VIDEO STUDIO</div>
        <h1 class="disp h1x" data-tr="Fikirlerinizi konuşan videolara sentezleyin.">Synthesize your ideas into talking video.</h1>
        <p class="lead" data-tr="Metin, sunum ya da PDF'ten; gerçekçi AI avatarlar ve 175+ dilde seslendirmeyle bitmiş videolar. Kamera yok, ekip yok, stüdyo yok.">Turn a script, deck, or PDF into a finished video — lifelike AI avatars and voiceover in 175+ languages. No camera, no crew, no studio.</p>
        <div class="hero-cta">
          <a class="btn btn-primary btn-lg" href="#"><span data-tr="Ücretsiz oluştur">Create for free</span></a>
          <a class="btn btn-ghost btn-lg" href="#"><span class="play">▶</span><span data-tr="Demoyu izle">Watch demo</span></a>
        </div>
        <div class="microcopy" data-tr="Kredi kartı gerekmez">No credit card required</div>
        <div class="metric-row">
          <div class="metric"><span class="metric-n" data-count="147" data-suffix="M+">0</span><span class="metric-l" data-tr="Oluşturulan video">Videos created</span></div>
          <div class="metric"><span class="metric-n" data-count="122" data-suffix="M+">0</span><span class="metric-l" data-tr="Üretilen avatar">Avatars generated</span></div>
          <div class="metric"><span class="metric-n" data-count="175" data-suffix="+">0</span><span class="metric-l" data-tr="Desteklenen dil">Languages supported</span></div>
        </div>
      </div>
      <div class="hero-visual reveal">
        <div class="beam-stage">
          <div class="beam-glow"></div>
          <div class="beam-inputs">
            <div class="frag"><span class="frag-ic">TXT</span><span data-tr="Senaryo satırı">Script line</span></div>
            <div class="frag"><span class="frag-ic">PDF</span><span>Deck.pdf</span></div>
            <div class="frag"><span class="frag-ic">IMG</span><span data-tr="Fotoğraf">Photo</span></div>
          </div>
          <div class="beam-track"><span class="beam-flow"></span></div>
          <div class="beam-avatar ph">
            <span class="ph-label">avatar demo</span>
            <div class="avatar-caption"><span class="rec-dot"></span><span data-tr="konuşuyor…">speaking…</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="eyebrow reveal" style="text-align:center" data-tr="DÜNYA GENELİNDE EKİPLER SENTEZY'E GÜVENİYOR">TEAMS WORLDWIDE TRUST SENTEZY</div>
      <div class="marquee">
        <div class="marquee-track">
          <span class="wordmark">Northwind</span><span class="wordmark">Vertex</span><span class="wordmark">LUMEN</span><span class="wordmark">Kavis</span><span class="wordmark">Orbita</span><span class="wordmark">Meridian</span><span class="wordmark">Aster</span><span class="wordmark">Polar</span><span class="wordmark">Northwind</span><span class="wordmark">Vertex</span><span class="wordmark">LUMEN</span><span class="wordmark">Kavis</span><span class="wordmark">Orbita</span><span class="wordmark">Meridian</span><span class="wordmark">Aster</span><span class="wordmark">Polar</span>
        </div>
      </div>
    </div>
  </section>

  <section class="sec mist" id="features">
    <div class="wrap">
      <div class="sec-head reveal">
        <div class="eyebrow" data-tr="YETENEKLER">CAPABILITIES</div>
        <h2 class="disp h2" data-tr="AI video üretimi artık sizin süper gücünüz">AI video creation is your new superpower.</h2>
      </div>
      <div class="grid3 stagger">
        <div class="card"><div class="chip"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M10 9l5 3-5 3z" fill="currentColor" stroke="none"></path></svg></div><h3 class="disp h3" data-tr="Metinden videoya">Text to video</h3><p data-tr="Bir senaryo yapıştırın, bitmiş video alın.">Paste a script and get a finished video.</p></div>
        <div class="card"><div class="chip"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="3.4"></circle><path d="M5 20c0-3.6 3.1-6 7-6s7 2.4 7 6"></path></svg></div><h3 class="disp h3" data-tr="AI avatarlar">AI avatars</h3><p data-tr="Gerçekçi sunucular ya da kendi ikiziniz.">Photoreal avatars or your own twin.</p></div>
        <div class="card"><div class="chip"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="8.5"></circle><path d="M3.5 12h17M12 3.5c2.6 2.6 2.6 14.4 0 17M12 3.5c-2.6 2.6-2.6 14.4 0 17"></path></svg></div><h3 class="disp h3" data-tr="Çeviri ve dudak senkronu">Translation &amp; lip-sync</h3><p data-tr="Doğal dudak senkronuyla 175+ dil.">175+ languages with natural lip-sync.</p></div>
        <div class="card"><div class="chip"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="5" y1="10" x2="5" y2="14"></line><line x1="9.5" y1="6" x2="9.5" y2="18"></line><line x1="14.5" y1="9" x2="14.5" y2="15"></line><line x1="19" y1="7" x2="19" y2="17"></line></svg></div><h3 class="disp h3" data-tr="Ses klonlama">Voice cloning</h3><p data-tr="Sesiniz, ihtiyacınız olan her dilde.">Your voice, in any language you need.</p></div>
        <div class="card"><div class="chip"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 8l-4 4 4 4M15 8l4 4-4 4"></path></svg></div><h3 class="disp h3" data-tr="Geliştirici API'si">Developer API</h3><p data-tr="Videoyu ölçekte programatik üretin.">Generate video programmatically at scale.</p></div>
      </div>
    </div>
  </section>

  <section class="sec" id="solutions">
    <div class="wrap">
      <div class="sec-head reveal" style="text-align:left;margin-left:0">
        <div class="eyebrow" data-tr="ÜRÜN">PRODUCT</div>
        <h2 class="disp h2" data-tr="Tek platform, uçtan uca">One platform, end to end.</h2>
      </div>
      <div class="zig reveal">
        <div class="zig-copy">
          <div class="eyebrow" data-tr="AVATARLAR">AVATARS</div>
          <h2 class="disp h2" data-tr="Kendi dijital ikizinizi oluşturun">Create your own digital twin.</h2>
          <ul class="blist">
            <li data-tr="İki dakika çekim yapın, gerçekçi bir avatar edinin.">Record two minutes, get a photoreal avatar.</li>
            <li data-tr="Yaş ve stillere göre 300+ hazır avatar.">300+ stock avatars across ages and styles.</li>
            <li data-tr="Senaryonuza uyan jest ve mimikler.">Gestures and expressions that match your script.</li>
          </ul>
          <a class="inline-cta" href="#"><span data-tr="Avatarları keşfedin">Explore avatars</span> →</a>
        </div>
        <div class="zig-media ph"><span class="ph-label">avatar studio — screenshot</span></div>
      </div>
      <div class="zig rev reveal">
        <div class="zig-copy">
          <div class="eyebrow" data-tr="ÇEVİRİ">TRANSLATION</div>
          <h2 class="disp h2" data-tr="Tek videoyu 175+ dile taşıyın">Ship one video in 175+ languages.</h2>
          <ul class="blist">
            <li data-tr="Tek tıkla senaryo ve ses otomatik çevrilir.">One click auto-translates script and voice.</li>
            <li data-tr="Her dilde doğal dudak senkronu.">Natural lip-sync in every language.</li>
            <li data-tr="Aynı avatar ve marka görünümü korunur.">Keep the same avatar and brand look.</li>
          </ul>
          <a class="inline-cta" href="#"><span data-tr="Çeviriyi görün">See translation</span> →</a>
        </div>
        <div class="zig-media ph"><span class="ph-label">translation panel — screenshot</span></div>
      </div>
      <div class="zig reveal">
        <div class="zig-copy">
          <div class="eyebrow" data-tr="AI STUDIO">AI STUDIO</div>
          <h2 class="disp h2" data-tr="Videoyu metin düzenler gibi kurgulayın">Edit video like editing text.</h2>
          <ul class="blist">
            <li data-tr="Bir kelimeyi değiştirin, video yeniden oluşur.">Change a word, the video re-renders.</li>
            <li data-tr="Sürükle-bırak sahneler, marka kitleri ve müzik.">Drag-and-drop scenes, brand kits, and music.</li>
            <li data-tr="Zaman çizelgesi ya da kurgu becerisi gerekmez.">No timeline, no editing skills needed.</li>
          </ul>
          <a class="inline-cta" href="#"><span data-tr="Stüdyoyu deneyin">Try the studio</span> →</a>
        </div>
        <div class="zig-media ph"><span class="ph-label">AI studio editor — screenshot</span></div>
      </div>
    </div>
  </section>

  <section class="sec mist">
    <div class="wrap">
      <div class="sec-head reveal">
        <div class="eyebrow" data-tr="KULLANIM ALANLARI">USE CASES</div>
        <h2 class="disp h2" data-tr="Her ekip için bir Sentezy">A Sentezy for every team.</h2>
      </div>
      <div class="grid4 stagger">
        <div class="uc"><div class="uc-num">01</div><h3 class="disp h3" data-tr="Pazarlama">Marketing</h3><p data-tr="Dakikalar içinde reklam, tanıtım ve sosyal.">Ads, promos, and social in minutes.</p></div>
        <div class="uc"><div class="uc-num">02</div><h3 class="disp h3" data-tr="Eğitim &amp; Gelişim">Training &amp; L&amp;D</h3><p data-tr="Ölçeklenen işe alım ve eğitimler.">Onboarding and courses that scale.</p></div>
        <div class="uc"><div class="uc-num">03</div><h3 class="disp h3" data-tr="Satış">Sales</h3><p data-tr="Ölçekli kişiselleştirilmiş erişim.">Personalized outreach at volume.</p></div>
        <div class="uc"><div class="uc-num">04</div><h3 class="disp h3" data-tr="Yerelleştirme">Localization</h3><p data-tr="Tek video, her pazar.">One video, every market.</p></div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head reveal">
        <div class="eyebrow" data-tr="NASIL ÇALIŞIR">HOW IT WORKS</div>
        <h2 class="disp h2" data-tr="Üç adımda video">Video in three steps.</h2>
      </div>
      <div class="steps stagger">
        <div class="step"><div class="step-n">01</div><h3 class="disp h3" data-tr="Yaz ya da içe aktar">Write or import</h3><p data-tr="Bir senaryo yapıştırın ya da sunum, PDF veya belge getirin.">Paste a script or bring a deck, PDF, or doc.</p></div>
        <div class="step"><div class="step-n">02</div><h3 class="disp h3" data-tr="Sentezle">Synthesize</h3><p data-tr="Bir avatar ve ses seçin — Sentezy videoyu oluşturur.">Pick an avatar and voice — Sentezy builds the video.</p></div>
        <div class="step"><div class="step-n">03</div><h3 class="disp h3" data-tr="Yayınla">Publish</h3><p data-tr="Her formatta dışa aktarın ya da API ile gönderin.">Export in any format, or push via API.</p></div>
      </div>
    </div>
  </section>

  <section class="sec mist" id="faq">
    <div class="wrap">
      <div class="sec-head reveal">
        <div class="eyebrow" data-tr="SSS">FAQ</div>
        <h2 class="disp h2" data-tr="Sık sorulan sorular">Frequently asked questions.</h2>
      </div>
      <div class="faq reveal">
        <div class="faq-item"><button class="faq-q" type="button"><span data-tr="Sentezy ücretsiz mi?">Is Sentezy free?</span><span class="faq-ic">+</span></button><div class="faq-a"><p data-tr="Evet — kredi kartı olmadan ücretsiz planla başlayın. Daha fazla dakika, avatar ya da koltuk gerektiğinde yükseltin.">Yes — start on the free plan with no credit card. Upgrade when you need more minutes, avatars, or seats.</p></div></div>
        <div class="faq-item"><button class="faq-q" type="button"><span data-tr="Kendi avatarımı oluşturabilir miyim?">Can I create my own avatar?</span><span class="faq-ic">+</span></button><div class="faq-a"><p data-tr="Kısa bir klip çekin, Sentezy her videoda kullanabileceğiniz gerçekçi bir dijital ikiz oluştursun.">Record a short clip and Sentezy builds a photoreal digital twin you can reuse across every video.</p></div></div>
        <div class="faq-item"><button class="faq-q" type="button"><span data-tr="Hangi dilleri destekliyor?">Which languages are supported?</span><span class="faq-ic">+</span></button><div class="faq-a"><p data-tr="Ses ve çeviri için doğal dudak senkronuyla 175+ dil — tam Türkçe desteği dahil.">175+ languages for voice and translation, with natural lip-sync — including full Turkish support.</p></div></div>
        <div class="faq-item"><button class="faq-q" type="button"><span data-tr="Verilerim güvende mi? (KVKK)">Is my data safe? (KVKK/GDPR)</span><span class="faq-ic">+</span></button><div class="faq-a"><p data-tr="Veriler aktarım ve saklama sırasında şifrelenir; KVKK, GDPR ve SOC 2 Type II ile uyumlu işlenir.">Data is encrypted in transit and at rest, and handled in line with KVKK, GDPR, and SOC 2 Type II.</p></div></div>
      </div>
    </div>
  </section>

  <section class="sec final">
    <div class="final-wash"></div>
    <div class="final-in reveal">
      <h2 class="disp h2" data-tr="İlk videonuzu bugün sentezleyin.">Synthesize your first video today.</h2>
      <a class="btn btn-primary btn-lg" href="#"><span data-tr="Ücretsiz başla">Start free</span></a>
      <div class="microcopy" style="margin-top:16px" data-tr="Kredi kartı gerekmez">No credit card required</div>
    </div>
  </section>

  <Footer />
</Base>

<script>
  import "../scripts/i18n";
  import "../scripts/reveal";
</script>
