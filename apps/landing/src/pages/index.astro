</Base>

<script>
  const q = (s: string) => Array.from(document.querySelectorAll<HTMLElement>(s));
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // i18n: store original EN text once, then swap on toggle
  q("[data-tr]").forEach((el) => {
    if (!el.hasAttribute("data-en")) el.setAttribute("data-en", el.textContent ?? "");
  });
  const swBtns = q("[data-switch]");
  const setLang = (l: string) => {
    q("[data-tr]").forEach((el) => {
      el.textContent = l === "tr" ? el.getAttribute("data-tr") : el.getAttribute("data-en");
    });
    swBtns.forEach((b) => b.classList.toggle("on", b.getAttribute("data-switch") === l));
    document.documentElement.lang = l;
  };
  swBtns.forEach((b) => b.addEventListener("click", () => setLang(b.getAttribute("data-switch") ?? "en")));

  // sticky/dock nav shadow on scroll
  const nav = document.querySelector(".nav");
  const onScroll = () => nav?.classList.toggle("scrolled", window.scrollY > 20);
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // count-up metrics
  const animate = (el: HTMLElement) => {
    if (el.dataset.done) return;
    el.dataset.done = "1";
    const target = Number(el.dataset.count), suf = el.dataset.suffix ?? "";
    if (reduce) { el.textContent = target + suf; return; }
    const dur = 1300;
    let s: number | null = null;
    const step = (t: number) => {
      if (s === null) s = t;
      const p = Math.min((t - s) / dur, 1);
      const e = 0.5 - Math.cos(p * Math.PI) / 2;
      el.textContent = Math.round(e * target) + suf;
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  // reveal on scroll + trigger counters
  if (reduce) {
    q(".reveal,.stagger").forEach((el) => el.classList.add("in"));
    q("[data-count]").forEach(animate);
  } else {
    const io = new IntersectionObserver(
      (es) => {
        es.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("in");
            e.target.querySelectorAll<HTMLElement>("[data-count]").forEach(animate);
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -8% 0px" },
    );
    q(".reveal,.stagger").forEach((el) => io.observe(el));
  }

  // faq accordion
  q(".faq-q").forEach((qq) => {
    qq.addEventListener("click", () => qq.closest(".faq-item")?.classList.toggle("open"));
  });
</script>
