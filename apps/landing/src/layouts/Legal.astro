---
/* Shared wrapper for the legal pages (Privacy, Terms, KVKK). Same nav and footer as the home
   page, with a readable single-column body. The clauses themselves live in each page's slot. */
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  updated: string;
  description?: string;
}
const { title, updated, description } = Astro.props;
---

<Base title={`${title} — Sentezy`} description={description ?? `${title} for Sentezy.`}>
  <Nav />
  <main class="legal">
    <div class="wrap legal-wrap">
      <a class="legal-back" href="/">← Back to home</a>
      <h1 class="disp">{title}</h1>
      <p class="legal-updated">Last updated {updated}</p>
      <div class="legal-body">
        <slot />
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .legal { padding: 132px 0 96px; }
  .legal-wrap { max-width: 760px; }
  .legal-back { display: inline-block; font-family: var(--font-mono); font-size: 13px; color: var(--color-muted); margin-bottom: 28px; }
  .legal-back:hover { color: var(--color-ink); }
  .legal h1 { font-size: 40px; line-height: 1.1; letter-spacing: -0.01em; font-weight: 700; color: var(--color-ink); margin: 0; }
  .legal-updated { font-family: var(--font-mono); font-size: 13px; color: var(--color-muted); margin: 12px 0 40px; }
  .legal-body :global(h2) { font-family: var(--font-display); font-size: 22px; font-weight: 600; color: var(--color-ink); margin: 40px 0 12px; }
  .legal-body :global(p) { font-size: 16px; line-height: 1.7; color: #3f3f46; margin: 0 0 16px; }
  .legal-body :global(ul) { margin: 0 0 16px; padding-left: 20px; }
  .legal-body :global(li) { font-size: 16px; line-height: 1.7; color: #3f3f46; margin-bottom: 8px; }
  .legal-body :global(a) { color: var(--color-ink); text-decoration: underline; text-underline-offset: 2px; }
  .legal-note { margin-top: 44px; padding: 18px 20px; border: 1px solid var(--color-hairline); border-radius: 14px; background: var(--wash); font-size: 14px; color: var(--color-muted); }

  @media (max-width: 640px) {
    .legal { padding: 108px 0 72px; }
    .legal h1 { font-size: 30px; }
  }
</style>
