---
import { getCopy, localeHref } from "../i18n";
import { INSTAGRAM_URL, TIKTOK_URL, YOUTUBE_URL } from "../data/site";

const { footer, sectors } = getCopy(Astro.currentLocale);
---

<footer class="footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="logo" href={localeHref(Astro.currentLocale, "/")}><img class="logo-mark" src="/sentezy-logo.png" alt="Sentezy" />Sentezy</a>
        <p>{footer.tagline}</p>
        <div class="foot-social">
          <a href={INSTAGRAM_URL} target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.7" />
              <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7" />
              <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" />
            </svg>
          </a>
          <a href={TIKTOK_URL} target="_blank" rel="noopener" aria-label="TikTok">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M14 4c.3 2.3 1.8 3.9 4 4.1v2.8c-1.4.05-2.8-.3-4-1v5.6a5 5 0 1 1-5-5c.35 0 .7.04 1 .1v2.9a2.1 2.1 0 1 0 1.5 2V4H14Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            </svg>
          </a>
          <a href={YOUTUBE_URL} target="_blank" rel="noopener" aria-label="YouTube">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="2.5" y="6" width="19" height="12" rx="3.5" stroke="currentColor" stroke-width="1.7" />
              <path d="M10.5 9.3v5.4l4.5-2.7-4.5-2.7Z" fill="currentColor" />
            </svg>
          </a>
        </div>
      </div>
      <div class="foot-col">
        <h4>{footer.productHead}</h4>
        <a href="#platform">{footer.presenters}</a>
        <a href="#platform">{footer.captions}</a>
        <a href="#platform">{footer.music}</a>
      </div>
      <div class="foot-col">
        <h4>{footer.solutionsHead}</h4>
        {/* Four of the 24, linking to the rail that holds all of them. */}
        {["beauty", "realestate", "fitness", "ecommerce"].map((k) => (
          <a href="#sectors">{sectors.items.find((s) => s.key === k)!.name}</a>
        ))}
      </div>
      <div class="foot-col">
        <h4>{footer.legalHead}</h4>
        <a href={localeHref(Astro.currentLocale, "kvkk")}>KVKK</a>
        <a href={localeHref(Astro.currentLocale, "privacy")}>{footer.privacy}</a>
        <a href={localeHref(Astro.currentLocale, "terms")}>{footer.terms}</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© 2026 Sentezy</span>
    </div>
  </div>
</footer>
