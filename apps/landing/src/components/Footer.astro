---
import { footer, nav, sectors } from "../data/copy";
import { INSTAGRAM_URL, SIGNUP_URL } from "../data/site";
---

<footer class="footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="logo" href="/"><img class="logo-mark" src="/sentezy-logo.png" alt="Sentezy" />Sentezy</a>
        <p>{footer.tagline}</p>
      </div>
      <div class="foot-col">
        <h4>{footer.productHead}</h4>
        <a href="#platform">{footer.presenters}</a>
        <a href="#platform">{footer.captions}</a>
        <a href="#platform">{footer.music}</a>
      </div>
      <div class="foot-col">
        <h4>{footer.solutionsHead}</h4>
        {/* Four of the 24, linking to the rail that holds all of them. */}
        {["beauty", "realestate", "fitness", "ecommerce"].map((k) => (
          <a href="#sectors">{sectors.items.find((s) => s.key === k)!.name}</a>
        ))}
      </div>
      <div class="foot-col">
        <h4>{footer.legalHead}</h4>
        <a href="/kvkk">KVKK</a>
        <a href="/privacy">{footer.privacy}</a>
        <a href="/terms">{footer.terms}</a>
      </div>
      <div class="foot-col">
        <h4>{footer.instagramHead}</h4>
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener">@sentezy.ai</a>
        <a href={SIGNUP_URL}>{nav.cta}</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© 2026 Sentezy</span>
      <span>{footer.madeFor}</span>
    </div>
  </div>
</footer>
