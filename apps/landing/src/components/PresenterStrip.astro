---
/* The presenter tiles, as a slim horizontal band under the proof bar.
 *
 * This was ReelMarquee — two 620px vertical columns filling the hero's visual half. It lost
 * that slot to the app demo, and for the right reason: on a phone the hero put the faces ABOVE
 * the headline, so the first screen was twelve strangers with no product and no pitch on it.
 *
 * The tiles themselves are unchanged. Only the axis is: they ride the shared `.marquee`
 * primitive now, which every other slider on the page already uses, so the band scrolls with
 * the reader instead of across them. It sits directly under the bar that claims 126 presenters
 * across 24 sectors, which is exactly what it is evidence for.
 */
import { Image } from "astro:assets";
import { columnA, columnB, type Still } from "../data/stills";
import { getStills } from "../i18n";

const { byId } = getStills(Astro.currentLocale);

/* The cutouts live in src/assets so astro:assets can downscale them and emit WebP — the
   originals are 1024x1536 PNGs and these render at 132px wide. A glob is needed because the
   slugs come from data; Astro resolves it at build time, so this stays fully static. */
const avatarImages = import.meta.glob<{ default: ImageMetadata }>("../assets/avatars/*.png", {
  eager: true,
});
const avatarOf = (slug: string): ImageMetadata => {
  const mod = avatarImages[`../assets/avatars/${slug}.png`];
  if (!mod) throw new Error(`no avatar image for slug "${slug}" — run pnpm --filter @sentezy/api export:stills`);
  return mod.default;
};

/* The two columns interleaved, so the sectors alternate along the row the way they used to
   alternate down the pair of columns. The track holds the list TWICE — `.marquee-track`
   translates exactly -50%, and a single pass would show a seam. */
const items: Still[] = columnA.flatMap((a, i) => (columnB[i] ? [a, columnB[i]] : [a]));
---

<section class="strip" aria-hidden="true">
  <div class="marquee" style="--speed:64s;--space:14px">
    <div class="marquee-track">
      {[...items, ...items].map((s) => (
        <div class={`tile tile-${s.tint}`}>
          <Image src={avatarOf(s.slug)} alt="" widths={[132, 264]} sizes="132px" loading="lazy" decoding="async" />
          <span class="tile-sector">{byId[s.id].sector}</span>
          <div class="tile-cap"><span class={`cap-${s.style}`}>{byId[s.id].caption}</span></div>
        </div>
      ))}
    </div>
  </div>
</section>
