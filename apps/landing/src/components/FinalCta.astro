---
/* The closer sits on light: the page now ends on the dark footer, and two dark bands in a row
   would read as one long black slab. */
import { finalCta } from "../data/copy";
import { SIGNUP_URL } from "../data/site";
---

<section class="sec final-cta">
  <div class="wrap">
    <div class="price-band reveal">
      <h2 class="disp h2">{finalCta.title}</h2>
      <a class="btn btn-primary btn-lg" href={SIGNUP_URL}><span>{finalCta.cta}</span></a>
      <div class="microcopy">{finalCta.microcopy}</div>
    </div>
  </div>
</section>
