---
/* PostHog product analytics. Loaded once from the <head> of every page (Base.astro), it captures
   pageviews and, through autocapture, the behaviour on top of them — clicks, rage-clicks, form
   interactions — with no per-element wiring.

   Configuration is read from build-time env vars, the same PUBLIC_ convention as PUBLIC_APP_URL:
     PUBLIC_POSTHOG_KEY   your project API key (Project settings → API keys). Required.
     PUBLIC_POSTHOG_HOST  ingestion host. Defaults to US cloud; use https://eu.i.posthog.com for EU.
   Set them in the Cloudflare Pages build environment (and a local .env for dev). With no key set,
   init is skipped, so nothing is sent and nothing breaks until you configure it.

   Docs: https://posthog.com/docs/libraries/astro */
---

<script>
  import posthog from "posthog-js";

  // `||`, not `??`: an unset var in .env reads back as "" (empty string), which `??` would keep,
  // pointing api_host at the current origin. `||` falls back for both "" and undefined.
  const key = import.meta.env.PUBLIC_POSTHOG_KEY;
  const host = import.meta.env.PUBLIC_POSTHOG_HOST || "https://us.i.posthog.com";

  if (key) {
    posthog.init(key, {
      api_host: host,
      defaults: "2025-05-24",
    });
  }
</script>
