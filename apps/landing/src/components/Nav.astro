    <a class="logo" href="/"><img class="logo-mark" src="/sentezy-logo.png" alt="Sentezy" />Sentezy</a>
    <nav class="nav-menu">
      <a href="#showcase">{nav.showcase}</a>
      <a href="#how">{nav.how}</a>
      <a href="#platform">{nav.platform}</a>
