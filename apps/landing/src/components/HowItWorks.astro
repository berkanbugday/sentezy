---
import { getCopy } from "../i18n";

const { how } = getCopy(Astro.currentLocale);
---

<section class="sec" id="how">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="eyebrow">{how.eyebrow}</div>
      <h2 class="disp h2">{how.title}</h2>
    </div>
    <div class="steps stagger">
      {how.steps.map((s) => (
        <div class="step">
          <div class="step-n">{s.n}</div>
          <h3 class="disp h3">{s.title}</h3>
          <p>{s.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
