---
/* Four choices, four phones. Every row is now a reel-style still: a real avatar cutout dropped
   into a bottom corner over a real reel frame, blurred and darkened in CSS so it reads as the soft
   B-roll behind a presenter. The choice each row demonstrates rides on top — the presenter's name,
   the voice, the track — the way a finished reel looks. The captions row is the exception: its
   sample is the point, so it keeps its overlay.

   Every row is the same object: one phone cycling slides and a row of chips lighting in step that
   you can also click to take over. No step numbers: the four are things you choose, not a sequence
   you complete, and on a phone the numbered rail was furniture between two thumbs. */
import { Image } from "astro:assets";
import { platform } from "../data/copy";
import { captionStyles, mmss, presenters, tracks, voices } from "../data/studio";

const avatars = import.meta.glob<{ default: ImageMetadata }>("../assets/avatars/*.png", { eager: true });
const face = (slug: string): ImageMetadata => {
  const mod = avatars[`../assets/avatars/${slug}.png`];
  if (!mod) throw new Error(`no avatar image for slug "${slug}"`);
  return mod.default;
};

/** The caption row keeps one presenter in the corner while the sample cycles through the styles. */
const HOST = "camila";

/** One reel frame sits behind each card, blurred and darkened in CSS so it reads as soft B-roll
 *  and its own burned captions disappear. Our own footage, so it is ours to use. */
const posters = import.meta.glob<{ default: ImageMetadata }>("../assets/posters/*.jpg", { eager: true });
const posterMeta = (file: string): ImageMetadata => {
  const mod = posters[`../assets/posters/${file}.jpg`];
  if (!mod) throw new Error(`no poster for reel "${file}"`);
  return mod.default;
};
/** The presenter row is the one that changes face — the others hold one presenter and one backdrop
 *  and only cycle their label (the voice, the track), so the eye watches the choice, not the scene. */
const presenterBg = ["4", "2", "1", "5", "6", "3"];
const VOICE_HOST = "hana";
const VOICE_BG = "3";
const MUSIC_HOST = "anna";
const MUSIC_BG = "1";
---

<section class="sec mist" id="platform">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="eyebrow">{platform.eyebrow}</div>
      <h2 class="disp h2">{platform.title}</h2>
      <p class="lead">{platform.lead}</p>
    </div>

    <div class="demo-row reveal" data-demo data-interval="2400" style="--dur:2400ms;--accent:#2e74c4">
      <div class="stage">
        <div class="glow"></div>
        <div class="phone">
          {presenters.map((p, i) => (
          <div class={`slide ${i % 2 ? "side-l" : "side-r"}${i === 0 ? " on" : ""}`} data-slide>
            <Image class="slide-bg" src={posterMeta(presenterBg[i % presenterBg.length])} alt="" widths={[300, 600]} sizes="300px" loading="lazy" decoding="async" />
            <Image class="slide-cutout" src={face(p.slug)} alt="" widths={[270, 540]} sizes="270px" loading="lazy" decoding="async" />
            <div class="slide-foot"><b>{p.name}</b><em>{p.sector}</em></div>
          </div>
        ))}
        </div>
      </div>
      <div class="demo-copy">
        <div class="eyebrow">{platform.presenters.eyebrow}</div>
        <h3 class="disp h3">{platform.presenters.title}</h3>
        <p>{platform.presenters.body}</p>
        <div class="demo-chips">
          {presenters.map((p, i) => (
            <button type="button" class={`chip${i === 0 ? " on" : ""}`} data-chip aria-pressed={i === 0 ? "true" : "false"}>{p.name}</button>
          ))}
        </div>
      </div>
    </div>

    <div class="demo-row rev reveal" data-demo data-interval="2800" style="--dur:2800ms;--accent:#28c4c0">
      <div class="stage">
        <div class="glow"></div>
        <div class="phone">
          {voices.map((v, i) => (
          <div class={`slide side-r${i === 0 ? " on" : ""}`} data-slide>
            <Image class="slide-bg" src={posterMeta(VOICE_BG)} alt="" widths={[300, 600]} sizes="300px" loading="lazy" decoding="async" />
            <Image class="slide-cutout" src={face(VOICE_HOST)} alt="" widths={[270, 540]} sizes="270px" loading="lazy" decoding="async" />
            <div class="slide-foot">
              <span class="wave" aria-hidden="true">{Array.from({ length: 15 }).map((_, b) => <i style={`--b:${b}`}></i>)}</span>
              <b>{v.name}</b>
              <em>{v.meta}</em>
            </div>
          </div>
        ))}
        </div>
      </div>
      <div class="demo-copy">
        <div class="eyebrow">{platform.voices.eyebrow}</div>
        <h3 class="disp h3">{platform.voices.title}</h3>
        <p>{platform.voices.body}</p>
        <div class="demo-chips">
          {voices.map((v, i) => (
            <button type="button" class={`chip${i === 0 ? " on" : ""}`} data-chip aria-pressed={i === 0 ? "true" : "false"}>{v.name}</button>
          ))}
        </div>
      </div>
    </div>

    <div class="demo-row reveal" data-demo data-interval="2600" style="--dur:2600ms;--accent:#e89260">
      <div class="stage">
        <div class="glow"></div>
        <div class="phone">
          {tracks.map((t, i) => (
          <div class={`slide side-r${i === 0 ? " on" : ""}`} data-slide>
            <Image class="slide-bg" src={posterMeta(MUSIC_BG)} alt="" widths={[300, 600]} sizes="300px" loading="lazy" decoding="async" />
            <Image class="slide-cutout" src={face(MUSIC_HOST)} alt="" widths={[270, 540]} sizes="270px" loading="lazy" decoding="async" />
            <div class="slide-foot">
              <span class="eq" aria-hidden="true">{t.bars.map((h, b) => <i style={`--h:${h}%;--b:${b}`}></i>)}</span>
              <b>{t.name}</b>
              <em>{t.mood} · {mmss(t.sec)}</em>
            </div>
          </div>
        ))}
        </div>
      </div>
      <div class="demo-copy">
        <div class="eyebrow">{platform.music.eyebrow}</div>
        <h3 class="disp h3">{platform.music.title}</h3>
        <p>{platform.music.body}</p>
        <div class="demo-chips">
          {tracks.map((t, i) => (
            <button type="button" class={`chip${i === 0 ? " on" : ""}`} data-chip aria-pressed={i === 0 ? "true" : "false"}>{t.mood}</button>
          ))}
        </div>
      </div>
    </div>

    <div class="demo-row rev reveal" data-demo data-interval="2200" style="--dur:2200ms;--accent:#d67096">
      <div class="stage">
        <div class="glow"></div>
        <div class="phone">
          {captionStyles.map((s, i) => (
          <div class={`slide side-r${i === 0 ? " on" : ""}`} data-slide>
            <Image class="slide-bg" src={posterMeta("4")} alt="" widths={[300, 600]} sizes="300px" loading="lazy" decoding="async" />
            <Image class="slide-cutout" src={face(HOST)} alt="" widths={[270, 540]} sizes="270px" loading="lazy" decoding="async" />
            <div class="slide-cap"><span class={`cap-${s.id}`}>{platform.captions.sample}</span></div>
          </div>
        ))}
        </div>
      </div>
      <div class="demo-copy">
        <div class="eyebrow">{platform.captions.eyebrow}</div>
        <h3 class="disp h3">{platform.captions.title}</h3>
        <p>{platform.captions.body}</p>
        <div class="demo-chips">
          {captionStyles.map((s, i) => (
            <button type="button" class={`chip${i === 0 ? " on" : ""}`} data-chip aria-pressed={i === 0 ? "true" : "false"}>{s.label}</button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
