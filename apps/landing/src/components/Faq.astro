---
import { faq } from "../data/copy";
---

<section class="sec mist" id="faq">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="eyebrow">{faq.eyebrow}</div>
      <h2 class="disp h2">{faq.title}</h2>
    </div>
    <div class="faq reveal">
      {faq.items.map((item) => (
        <div class="faq-item">
          <button class="faq-q" type="button">
            <span>{item.q}</span>
            <span class="faq-ic">+</span>
          </button>
          <div class="faq-a"><p>{item.a}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>
