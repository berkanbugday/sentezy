---
/* Desktop leads with the vertical marquee beside the copy. A phone leads with faces: the strip
   above the headline slides horizontally, so the first thing on screen is presenters, not a
   paragraph about them. The two are exclusive — only one is ever displayed. */
import { Image } from "astro:assets";
import { hero } from "../data/copy";
import { SIGNUP_URL } from "../data/site";
import { stills } from "../data/stills";
import ReelMarquee from "./ReelMarquee.astro";

const faces = import.meta.glob<{ default: ImageMetadata }>("../assets/avatars/*.png", { eager: true });
---

<section class="hero">
  <div class="hero-strip marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => stills.map((s) => (
        <div class={`striptile tile-${s.tint}`}>
          <Image src={faces[`../assets/avatars/${s.slug}.png`]!.default} alt="" widths={[120, 240]} sizes="110px" loading="lazy" decoding="async" />
        </div>
      )))}
    </div>
  </div>
  <div class="wrap hero-grid">
    <div class="hero-copy reveal">
      <div class="eyebrow">{hero.eyebrow}</div>
      <h1 class="disp h1x">{hero.title}</h1>
      <p class="lead">{hero.lead}</p>
      <div class="hero-cta">
        <a class="btn btn-primary btn-lg" href={SIGNUP_URL}><span>{hero.ctaPrimary}</span></a>
        <a class="btn btn-ghost btn-lg" href="#showcase"><span class="play">▶</span><span>{hero.ctaSecondary}</span></a>
      </div>
      <div class="microcopy">{hero.microcopy}</div>
    </div>
    <div class="hero-visual"><ReelMarquee /></div>
  </div>
</section>
