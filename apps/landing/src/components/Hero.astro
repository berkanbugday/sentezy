---
/* Copy on one side, the app demo on the other — and on a phone, in that order.
 *
 * The visual half used to be the vertical presenter marquee, and below 900px it was pulled
 * ABOVE the copy. That meant a phone opened on a wall of AI faces with the eyebrow, the
 * headline and the CTA all below the fold: nothing on the first screen said what the product
 * was. HeroDemo replaces it and the order flip is gone, so the first screen now reads
 * pitch → demo → button. The marquee still ships, as PresenterStrip under the proof bar.
 */
import { getCopy } from "../i18n";
import { startUrl } from "../data/site";
import HeroDemo from "./HeroDemo.astro";

const { hero } = getCopy(Astro.currentLocale);
---

<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy reveal">
      <div class="eyebrow">{hero.eyebrow}</div>
      <h1 class="disp h1x">{hero.title}</h1>
      <p class="lead">{hero.lead}</p>
      <div class="hero-cta">
        <a class="btn btn-primary btn-lg" href={startUrl(Astro.currentLocale)}><span>{hero.ctaPrimary}</span></a>
        <a class="btn btn-ghost btn-lg" href="#showcase"><span class="play">▶</span><span>{hero.ctaSecondary}</span></a>
      </div>
      <div class="microcopy">{hero.microcopy}</div>
    </div>
    <div class="hero-visual"><HeroDemo /></div>
  </div>
</section>
