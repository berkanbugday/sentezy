---
/* The hero's animated app demo.
 *
 * A rebuild of the real composer (apps/web/src/components/MediaComposer.tsx) inside a browser
 * frame, walked by a fake cursor. It exists because nothing else on this page ever showed the
 * product: the visitor used to land on a wall of faces and leave before the headline.
 *
 * Every state renders at once and CSS reveals exactly one, keyed off `[data-hd][data-step]`.
 * Nothing here is `display: none` — the cursor measures its targets with getBoundingClientRect
 * at the moment it moves, and an element with no box has no rect to aim at.
 *
 * The timeline lives in src/data/heroDemo.ts and the driver in src/scripts/hero-demo.ts.
 */
import { Image } from "astro:assets";
import { getCopy, getStudio } from "../i18n";
import {
  CAPTIONS, CLIPS, FACES, PICKED_CAPTION, PICKED_FACE, PICKED_FACE_NAME,
  RESULT_POSTER, RESULT_REEL, TR_GRADIENT, TR_GRADIENT_SOFT,
} from "../data/heroDemo";

const { heroDemo: d } = getCopy(Astro.currentLocale);
const { captionLabels } = getStudio(Astro.currentLocale);

/* Same globs Platform.astro uses — the slugs come from data, so Astro has to be told at build
   time which files can be reached. Both resolve statically; nothing is fetched at runtime. */
const avatars = import.meta.glob<{ default: ImageMetadata }>("../assets/avatars/*.png", { eager: true });
const face = (slug: string): ImageMetadata => {
  const mod = avatars[`../assets/avatars/${slug}.png`];
  if (!mod) throw new Error(`hero demo: no avatar image for "${slug}"`);
  return mod.default;
};
const posters = import.meta.glob<{ default: ImageMetadata }>("../assets/posters/*.jpg", { eager: true });
const poster = (file: string): ImageMetadata => {
  const mod = posters[`../assets/posters/${file}.jpg`];
  if (!mod) throw new Error(`hero demo: no poster for reel "${file}"`);
  return mod.default;
};
/* The dragged-in media. A photo is itself; a clip is its extracted first frame, because the
   sources run to 14 MB and these render at 68px. */
const bgs = import.meta.glob<{ default: ImageMetadata }>("../assets/backgrounds/*.jpg", { eager: true });
const clipStill = (c: { slug: string; kind: string }): ImageMetadata => {
  const name = c.kind === "image" ? c.slug : `thumb-${c.slug}`;
  const mod = bgs[`../assets/backgrounds/${name}.jpg`];
  if (!mod) throw new Error(`hero demo: no still for background "${c.slug}" — expected ${name}.jpg`);
  return mod.default;
};
---

<div class="hd" data-hd data-step="idle">
  <div class="hd-glow" aria-hidden="true"></div>

  {/* The app's own shell, not a browser window: a dark `--frame` chrome carrying the sidebar,
      with the content on an inset white panel. That "floating workspace" is what
      apps/web/src/components/AppShell.tsx renders and is the product's signature look — a
      traffic-light title bar would have been a stock SaaS-screenshot cliché that happens to
      contain Sentezy. Both `--frame` and `--hero` are already declared in this stylesheet with
      the exact values apps/web/src/app/globals.css uses. */}
  <div class="appwin">
    <aside class="appside">
      <div class="appside-brand">
        <img src="/sentezy-mark-light.png" alt="" width="26" height="26" />
        <span>Sentezy</span>
      </div>

      {/* Labels, order and icons copied from Sidebar.tsx's NAV — including "Your videos"
          rather than "Library", which is what the rail actually says. */}
      <nav class="appside-nav">
        <span class="on">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"></path><path d="M5 9.5V21h14V9.5"></path></svg>
          {d.nav.home}
        </span>
        <span class="lib">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="14" height="12" rx="2"></rect><path d="m17 10 4-2v8l-4-2"></path></svg>
          {d.nav.library}
        </span>
        <span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.2"></circle><path d="M5 20c0-3.5 3.1-6 7-6s7 2.5 7 6"></path></svg>
          {d.nav.presenters}
        </span>
        <span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 20 7v10l-8 4-8-4V7z"></path><path d="M4 7l8 4 8-4M12 11v10"></path></svg>
          {d.nav.brand}
        </span>
      </nav>

      <div class="appside-foot">
        <span class="credit-pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h6l-1 8 9-12h-6z"></path></svg>
          {d.credits}
        </span>
      </div>
    </aside>

    <div class="apppanel">
      <div class="panel">
        <main class="appmain">
          {/* The dashboard's aurora block — `hero-aurora` in the real app — bleeding to the
              panel edges behind the heading and the composer. */}
          <div class="aurora">
        <div class="appmain-head">
          <h3>{d.dashTitle}</h3>
          <p>{d.dashLead}</p>
        </div>

        <div class="compose">
          <div class="compose-tabs">
            <span>{d.tabLink}</span>
            <span class="on">{d.tabUpload}</span>
          </div>

          {/* The empty dropzone and the filled tray are stacked in one fixed-height slot, so
              the card does not resize the instant the clips land and yank the controls — and
              the script box below it — out from under the cursor. */}
          <div class="compose-slot">
            <div class="drop" data-anchor="drop">
              <span class="drop-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="3"></rect><circle cx="8.5" cy="8.5" r="1.6"></circle><path d="m21 15-5-5L5 21"></path>
                </svg>
              </span>
              <b>{d.dropTitle}</b>
              <em>{d.dropHint}</em>
            </div>

            <div class="tray">
              {CLIPS.map((c, i) => (
                <>
                  {/* The connector the real composer draws between two clips: a gradient hairline
                      through a node carrying the transition for that gap. */}
                  {i > 0 && (
                    <span class="tr-gap" style={`--i:${i}`}>
                      <span class="tr-line">
                        <i style={`background:${TR_GRADIENT}`}></i>
                        <b style={`background:${TR_GRADIENT_SOFT}`}>
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m21.64 3.64-1.28-1.28a1.21 1.21 0 0 0-1.72 0L2.36 18.64a1.21 1.21 0 0 0 0 1.72l1.28 1.28a1.2 1.2 0 0 0 1.72 0L21.64 5.36a1.2 1.2 0 0 0 0-1.72Z"></path><path d="m14 7 3 3"></path><path d="M5 6v4M19 14v4M10 2v2M7 8H3M21 16h-4M11 3H9"></path></svg>
                        </b>
                        <i style={`background:${TR_GRADIENT}`}></i>
                      </span>
                      <em>{d.transitionLabel}</em>
                    </span>
                  )}
                  <div class="clip" style={`--i:${i}`}>
                    <Image src={clipStill(c)} alt="" widths={[96, 192]} sizes="96px" loading="eager" decoding="async" />
                    {c.kind === "video" && (
                      <span class="clip-kind">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
                        video
                      </span>
                    )}
                    <span class="clip-spin"></span>
                    <span class="clip-ok">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"></path></svg>
                    </span>
                  </div>
                </>
              ))}
              <div class="clip-add">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"></path></svg>
                <em>{d.addMedia}</em>
              </div>
            </div>
          </div>

          <div class="compose-script" data-anchor="script">
            <span class="script-ph">{d.scriptPlaceholder}</span>
            <span class="script-real"><span data-hd-type></span><i class="caret"></i></span>
          </div>

          <div class="compose-row">
            {/* ActionMenu's `lg` trigger: a circular icon button with a count bubble on its
                top-right corner, ringed in paper so it reads off the card. It is NOT a labelled
                pill — an earlier draft invented one, and the real control has no text at all. */}
            <button type="button" class="cbtn cbtn-ico cbtn-opt" data-anchor="options" aria-label={d.options}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"></path></svg>
              <span class="cbtn-badge"><i class="b1">1</i><i class="b2">2</i></span>
            </button>
            <button type="button" class="cbtn cbtn-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3.2"></circle>
                <path d="M12 2.6v2.2M12 19.2v2.2M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M2.6 12h2.2M19.2 12h2.2M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6"></path>
              </svg>
            </button>
            <button type="button" class="cbtn cbtn-prev">
              <svg viewBox="0 0 24 24" fill="currentColor" class="cbtn-play"><path d="M8 5v14l11-7z"></path></svg>{d.preview}
            </button>
            <button type="button" class="cbtn cbtn-go" data-anchor="make">
              <span class="go-label">{d.make}</span>
              <span class="go-making">{d.making}</span>
              <span class="go-spin"></span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="go-arrow"><path d="M5 12h13m-5-6 6 6-6 6"></path></svg>
            </button>
          </div>

        {/* The ActionMenu popover. Its four rows are the real ones; only Presenter and Captions
            get walked, so Voice shows a value from the start rather than adding a fifth beat to
            an already long loop.

            It lives INSIDE the card, not beside it: positioned against .appmain it would drift
            off the button whenever the card's height changed, and the card's height changes
            with the locale — Turkish runs longer. */}
        <div class="hd-menu">
          {/* Both values are rendered and CSS swaps them, because a stylesheet cannot rewrite
              text — and doing it from the driver would put copy in a script, where the i18n
              type check cannot reach it. */}
          <button type="button" class="hd-menu-row" data-anchor="menu-presenter">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.2"></circle><path d="M5 20c0-3.5 3.1-6 7-6s7 2.5 7 6"></path></svg>
            <b>{d.menuPresenter}</b>
            <em class="v-presenter"><i class="v-off">{d.menuNone}</i><i class="v-on">{PICKED_FACE_NAME}</i></em>
          </button>
          <button type="button" class="hd-menu-row"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="3" width="6" height="11" rx="3"></rect><path d="M5 11a7 7 0 0 0 14 0M12 18v3"></path></svg><b>{d.menuVoice}</b><em>{d.voiceValue}</em></button>
          <button type="button" class="hd-menu-row"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l11-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="17" cy="16" r="3"></circle></svg><b>{d.menuMusic}</b><em>{d.menuNone}</em></button>
          <button type="button" class="hd-menu-row" data-anchor="menu-captions">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="5" width="19" height="14" rx="2.5"></rect><path d="M6.5 15h5M6.5 11.5h11M13.5 15h5"></path></svg>
            <b>{d.menuCaptions}</b>
            <em class="v-caption"><i class="v-off">{d.menuNone}</i><i class="v-on">{captionLabels[PICKED_CAPTION]}</i></em>
          </button>
          </div>
        </div>
          </div>

        {/* Both pickers are AvatarPicker.tsx's sheet: a blurred scrim, a rounded panel, a
            title row with a close control, the grid, and a Done button that commits the choice.
            The header and footer are not decoration — a modal with no way out and no way to
            confirm reads as a screenshot rather than a screen. */}
        <div class="hd-modal hd-modal-av">
          <div class="hd-sheet">
            <div class="sheet-head">
              <h4>{d.pickPresenter}</h4>
              <span class="sheet-x" aria-label={d.pickerClose}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6 6 18"></path></svg>
              </span>
            </div>
            <div class="avgrid">
              {FACES.map((f) => (
                <div class={`av${f.slug === PICKED_FACE ? " target" : ""}`} data-anchor={f.slug === PICKED_FACE ? "pick-presenter" : undefined}>
                  <div class="av-tile">
                    <Image src={face(f.slug)} alt="" widths={[104, 208]} sizes="104px" loading="lazy" decoding="async" />
                    <span class="av-tick">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"></path></svg>
                    </span>
                  </div>
                  <b>{f.name}</b>
                </div>
              ))}
            </div>
            <div class="sheet-foot"><span class="cbtn cbtn-go sheet-done">{d.pickerDone}</span></div>
          </div>
        </div>

        <div class="hd-modal hd-modal-cap">
          <div class="hd-sheet">
            <div class="sheet-head">
              <h4>{d.pickCaption}</h4>
              <span class="sheet-x" aria-label={d.pickerClose}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6 6 18"></path></svg>
              </span>
            </div>
            <div class="capgrid">
              {CAPTIONS.map((c) => (
                <div class={`capt${c === PICKED_CAPTION ? " target" : ""}`} data-anchor={c === PICKED_CAPTION ? "pick-caption" : undefined}>
                  <div class="capt-tile">
                    <span class={`cap-${c}`}>{captionLabels[c]}</span>
                    <span class="av-tick">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"></path></svg>
                    </span>
                  </div>
                  <b>{captionLabels[c]}</b>
                </div>
              ))}
            </div>
            <div class="sheet-foot"><span class="cbtn cbtn-go sheet-done">{d.pickerDone}</span></div>
          </div>
        </div>

        {/* The result. It covers the composer but not the sidebar — the visitor is still in
            the app, which is the point: this is where their video ends up, and the sidebar
            moves its highlight to Library to say so. */}
        <div class="hd-done">
        <div class="hd-done-head">
          <span class="hd-tick">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"></path></svg>
          </span>
          <b>{d.ready}</b>
        </div>
        <div class="hd-reel">
          <video
            data-hd-video
            src={RESULT_REEL}
            poster={poster(RESULT_POSTER).src}
            muted
            playsinline
            loop
            preload="none"
            aria-hidden="true"
          ></video>
        </div>
        <span class="cbtn cbtn-go hd-dl">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v12m-5-5 5 5 5-5M5 20h14"></path></svg>{d.download}
        </span>
        </div>
        </main>
      </div>
    </div>

    {/* Where the cursor rests before the first beat and after the last — off the controls, so
        it never sits on something it is not about to press. */}
    <span class="hd-park" data-anchor="start" aria-hidden="true"></span>
  </div>

  <span class="hd-cursor" data-hd-cursor aria-hidden="true">
    <svg viewBox="0 0 24 24"><path d="m4 2 7.5 18 2.4-7.1 7.1-2.4z"></path></svg>
  </span>

  {/* The part that has to work for someone who never parses the UI. */}
  <ol class="hd-steps">
    {d.steps.map((s, i) => <li style={`--n:${i}`}>{s}</li>)}
  </ol>

  {/* The typewriter's source text. It lives in the markup, not in hero-demo.ts, so it stays
      inside the i18n type check — a script cannot be checked against Copy. */}
  <span data-hd-script-src hidden>{d.script}</span>
</div>
