---
/* The platform section: three live demos of the app's own pickers, rebuilt in CSS.
   Filters here really filter and the voice list really plays through — a screenshot of a
   picker shows that a picker exists; a working one shows what picking feels like.
   No audio is played and no play control is drawn: the waveform marks which row is being
   read in the demo, and nothing pretends to be an audition. */
import { Image } from "astro:assets";
import { studio } from "../data/copy";
import { moodFilters, mmss, presenterFilters, presenters, tracks, voices } from "../data/studio";

const avatarImages = import.meta.glob<{ default: ImageMetadata }>("../assets/avatars/*.png", { eager: true });
const avatarOf = (slug: string): ImageMetadata => {
  const mod = avatarImages[`../assets/avatars/${slug}.png`];
  if (!mod) throw new Error(`no avatar image for slug "${slug}"`);
  return mod.default;
};
---

<section class="sec mist" id="platform">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="eyebrow" data-tr={studio.eyebrow.tr}>{studio.eyebrow.en}</div>
      <h2 class="disp h2" data-tr={studio.title.tr}>{studio.title.en}</h2>
      <p class="lead" data-tr={studio.lead.tr}>{studio.lead.en}</p>
    </div>

    <div class="zig reveal">
      <div class="zig-copy">
        <div class="eyebrow" data-tr={studio.presenters.eyebrow.tr}>{studio.presenters.eyebrow.en}</div>
        <h2 class="disp h2" data-tr={studio.presenters.title.tr}>{studio.presenters.title.en}</h2>
        <ul class="blist">
          {studio.presenters.bullets.map((li) => <li data-tr={li.tr}>{li.en}</li>)}
        </ul>
      </div>
      <div class="panel">
        <div class="chips" role="group" data-filter-group="faces">
          {presenterFilters.map((f, i) => (
            <button type="button" class={`chip${i === 0 ? " on" : ""}`} data-filter={f.id} aria-pressed={i === 0 ? "true" : "false"}>
              <span data-tr={f.label.tr}>{f.label.en}</span><span class="chip-n">{f.count}</span>
            </button>
          ))}
        </div>
        <div class="faces" data-filter-items="faces">
          {presenters.map((p) => (
            <figure class="face" data-tags={p.tags}>
              <div class={`face-shot tile-${p.tint}`}>
                <Image src={avatarOf(p.slug)} alt="" widths={[160, 320]} sizes="120px" loading="lazy" decoding="async" />
              </div>
              <figcaption>
                <b>{p.name}</b>
                <span data-tr={p.sector.tr}>{p.sector.en}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>

    <div class="zig rev reveal">
      <div class="zig-copy">
        <div class="eyebrow" data-tr={studio.voices.eyebrow.tr}>{studio.voices.eyebrow.en}</div>
        <h2 class="disp h2" data-tr={studio.voices.title.tr}>{studio.voices.title.en}</h2>
        <ul class="blist">
          {studio.voices.bullets.map((li) => <li data-tr={li.tr}>{li.en}</li>)}
        </ul>
      </div>
      <div class="panel">
        <div class="rows" data-voice-list>
          {voices.map((v, i) => (
            <div class={`row${i === 0 ? " on" : ""}`}>
              <div class="row-main">
                <b>{v.name}</b>
                <span class="row-meta">
                  <span data-tr={v.tone.tr}>{v.tone.en}</span> · <span data-tr={v.age.tr}>{v.age.en}</span>
                </span>
              </div>
              <div class="wave" aria-hidden="true">
                {Array.from({ length: 13 }).map((_, b) => <i style={`--b:${b}`}></i>)}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="zig reveal">
      <div class="zig-copy">
        <div class="eyebrow" data-tr={studio.music.eyebrow.tr}>{studio.music.eyebrow.en}</div>
        <h2 class="disp h2" data-tr={studio.music.title.tr}>{studio.music.title.en}</h2>
        <ul class="blist">
          {studio.music.bullets.map((li) => <li data-tr={li.tr}>{li.en}</li>)}
        </ul>
      </div>
      <div class="panel">
        <div class="chips" role="group" data-filter-group="tracks">
          {moodFilters.map((f, i) => (
            <button type="button" class={`chip${i === 0 ? " on" : ""}`} data-filter={f.id} aria-pressed={i === 0 ? "true" : "false"}>
              <span data-tr={f.label.tr}>{f.label.en}</span><span class="chip-n">{f.count}</span>
            </button>
          ))}
        </div>
        <div class="rows scroller" data-filter-items="tracks">
          {tracks.map((t) => (
            <div class="row" data-tags={t.mood}>
              <div class="row-main">
                <b>{t.name}</b>
                <span class="row-meta" data-tr={t.moodLabel.tr}>{t.moodLabel.en}</span>
              </div>
              <span class="row-dur">{mmss(t.sec)}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
