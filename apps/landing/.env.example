# Copy to .env for local dev, and set the same vars in the Cloudflare Pages build environment.

# Where the "Start free" / login links point (the web app). Falls back to http://localhost:3000.
PUBLIC_APP_URL=

# PostHog analytics. Project API key from Project settings → API keys.
# Leave blank to disable analytics entirely (nothing is sent).
PUBLIC_POSTHOG_KEY=
# Ingestion host. Leave blank for US cloud; set https://eu.i.posthog.com if your project is EU.
# (Check your PostHog URL: us.posthog.com = US, eu.posthog.com = EU.)
PUBLIC_POSTHOG_HOST=
