# Sentezy environment — copy to .env and fill in.
# IMPORTANT: comments live on their OWN lines, never inline after `KEY=value`,
# so every value parses cleanly in Node/Python/shell dotenv loaders.

# ── Supabase (db + auth) ────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# server-only (api, worker). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# api uses this to verify user JWTs
SUPABASE_JWT_SECRET=
# Postgres connection URI — Dashboard → Database → Connection string → URI
# (includes the DB password). Used to apply migrations with psql / the CLI.
SUPABASE_DB_URL=

# ── Redis (queue) ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Cloudflare R2 (audio + video storage, S3-compatible) ────────────────
# Cloudflare account id (32-hex; used for the R2 S3 endpoint)
R2_ACCOUNT_ID=
# Create under R2 → Manage API tokens (S3 credentials)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sentezy-media
# public/CDN base URL for delivering finished reels
R2_PUBLIC_URL=

# ── AI providers ────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=
# Optional — per-sentence emotion-tagging LLM pass. OpenRouter (free) preferred, Anthropic fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,google/gemini-2.5-flash
# Vision model for the wizard "add emotion" button (must accept image input).
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,google/gemini-2.5-flash
ANTHROPIC_API_KEY=

# ── Service wiring ──────────────────────────────────────────────────────
API_URL=http://localhost:8080
NODE_ENV=development

# ── Web (Next.js) public vars — safe to expose ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8080
