# Sentezy environment — copy to .env and fill in.
# IMPORTANT: comments live on their OWN lines, never inline after `KEY=value`,
# so every value parses cleanly in Node/Python/shell dotenv loaders.

# ── Supabase (db + auth) ────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# server-only (api, worker). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# api uses this to verify user JWTs
SUPABASE_JWT_SECRET=
# Postgres connection URI — Dashboard → Database → Connection string → URI
# (includes the DB password). Used to apply migrations with psql / the CLI.
SUPABASE_DB_URL=

# ── Redis (queue) ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Cloudflare R2 (audio + video storage, S3-compatible) ────────────────
# Cloudflare account id (32-hex; same account hosts Cloudflare Images)
R2_ACCOUNT_ID=
# Create under R2 → Manage API tokens (S3 credentials)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sentezy-media
# public/CDN base URL for delivering finished reels
R2_PUBLIC_URL=

# ── Cloudflare Images (photos, backgrounds, logos, thumbnails) ──────────
# server-only (api + worker)
CF_IMAGES_API_TOKEN=
# delivery base = https://imagedelivery.net/<hash>
CF_IMAGES_ACCOUNT_HASH=

# ── AI providers ────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=
# true → HeyGen renders watermarked "test" videos that don't spend paid credits
# (used for local end-to-end runs). Leave false/unset in production.
HEYGEN_TEST_MODE=false

# ── Service wiring ──────────────────────────────────────────────────────
API_URL=http://localhost:8080
NODE_ENV=development

# ── Web (Next.js) public vars — safe to expose ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8080

# public CF Images delivery hash (browser builds thumbnail URLs)
NEXT_PUBLIC_CF_IMAGES_HASH=
