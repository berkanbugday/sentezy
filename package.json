{
  "name": "sentezy",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "clean": "turbo run clean",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --build",
    "infra:redis": "docker compose -f infra/docker-compose.yml up -d redis",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:ps": "docker compose -f infra/docker-compose.yml ps",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f --tail 100",
    "infra:restart": "docker compose -f infra/docker-compose.yml restart worker",
    "infra:reset": "docker compose -f infra/docker-compose.yml down --remove-orphans -v"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.716.0",
    "prettier": "3.3.3",
    "turbo": "2.3.3",
    "typescript": "5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp"
    ]
  }
}