// Sentezy database schema (Prisma, PostgreSQL / Supabase).
//
// Notes:
// - `userId` fields reference Supabase's `auth.users` (a schema Prisma does not own).
//   Those FK constraints + the auth trigger + RLS + Realtime live in the companion
//   migration `.../supabase_rls_triggers/migration.sql` (raw SQL, applied by migrate deploy).
// - `updated_at` is maintained by a DB trigger (so it updates for the Python worker too),
//   not Prisma's @updatedAt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("SUPABASE_DB_URL")
}

/// 1:1 with auth.users — id IS the auth user id.
model Profile {
  id          String   @id @db.Uuid
  displayName String?  @map("display_name")
  plan        String   @default("free")
  credits     Int      @default(30)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
}

model Avatar {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String       @map("user_id") @db.Uuid
  name                 String
  sourceImageId        String       @map("source_image_id")
  previewImageId       String?      @map("preview_image_id")
  heygenTalkingPhotoId String?      @map("heygen_talking_photo_id")
  status               AvatarStatus @default(pending)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  videos               Video[]

  @@index([userId])
  @@map("avatars")
}

// The browseable avatar library (the 124 curated personas). Public reference data,
// seeded from apps/api/src/data/avatars.json — distinct from the per-user `Avatar`
// records above. `/avatars` filters this table (sector/gender/age/hijab) in the DB.
model CatalogAvatar {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String   @unique
  name            String
  sector          String
  sectorLabel     String   @map("sector_label")
  gender          String
  age             String
  ethnicity       String
  hijab           Boolean  @default(false)
  imageKey        String   @default("") @map("image_key") // R2 green-screen source key ("" = pending generation)
  displayImageKey String   @default("") @map("display_image_key") // R2 matted thumbnail key (picker)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([sector])
  @@map("avatar_catalog")
}

/// Curated background-music beds. Files live in R2 under music/*.mp3; seeded from
/// apps/api/src/data/music.json.
model CatalogMusic {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  mood        String
  moodLabel   String   @map("mood_label")
  r2Key       String   @map("r2_key")
  durationSec Int      @default(0) @map("duration_sec")
  source      String   @default("")
  license     String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([mood])
  @@map("music_catalog")
}

/// The user's reusable brand identity — logo, name, colour, optional intro/outro clips.
/// One kit per user (hence the unique userId), edited on /brand-kit. A video does NOT
/// reference this row: enabling branding SNAPSHOTS the kit into videos.options.branding
/// so re-rendering an old video keeps the branding it was made with, even after the kit
/// changes. Clip durations are measured in the browser at upload and stored here, so the
/// preview and the render agree on reel length without probing the file.
model BrandKit {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  brandName    String?  @map("brand_name")
  handle       String?
  logoKey      String?  @map("logo_key")
  color        String   @default("#0A0A0B")
  font         String   @default("General Sans")
  outroCta     String?  @map("outro_cta")
  introClipKey String?  @map("intro_clip_key")
  introClipMs  Int?     @map("intro_clip_ms")
  outroClipKey String?  @map("outro_clip_key")
  outroClipMs  Int?     @map("outro_clip_ms")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // Prisma-maintained, unlike the other tables. The header note above prescribes a DB
  // trigger so the Python worker's writes bump it too — but the worker never touches a
  // brand kit (only the API does, through Prisma), and that trigger does not actually
  // exist on the database. @updatedAt is the option that works here.
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("brand_kits")
}

model Voice {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  elevenlabsVoiceId String   @map("elevenlabs_voice_id")
  label             String
  gender            String?
  style             String?
  isPublic          Boolean  @default(true) @map("is_public")
  userId            String?  @map("user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  videos            Video[]

  @@index([userId])
  @@map("voices")
}

model Video {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  title            String
  script           String
  avatarId         String?        @map("avatar_id") @db.Uuid
  voiceId          String?        @map("voice_id") @db.Uuid
  aspectRatio      AspectRatio    @default(r9_16) @map("aspect_ratio")
  options          Json           @default("{}")
  status           VideoStatus    @default(draft)
  stage            VideoStage?
  progress         Int            @default(0)
  outputKey        String?        @map("output_key")
  thumbnailImageId String?        @map("thumbnail_image_id")
  durationS        Decimal?       @map("duration_s") @db.Decimal
  creditsCost      Int            @default(1) @map("credits_cost")
  error            String?
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  avatar           Avatar?        @relation(fields: [avatarId], references: [id], onDelete: SetNull)
  voice            Voice?         @relation(fields: [voiceId], references: [id], onDelete: SetNull)
  jobs             Job[]
  creditLedger     CreditLedger[]

  @@index([userId, createdAt])
  @@map("videos")
}

model Job {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  videoId   String   @map("video_id") @db.Uuid
  streamId  String?  @map("stream_id")
  status    String   @default("queued")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@map("jobs")
}

model CreditLedger {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  delta     Int
  reason    String
  videoId   String?  @map("video_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  video     Video?   @relation(fields: [videoId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("credit_ledger")
}

enum VideoStatus {
  draft
  queued
  processing
  ready
  failed

  @@map("video_status")
}

enum VideoStage {
  tts
  avatar
  compose
  thumbnail
  done

  @@map("video_stage")
}

enum AvatarStatus {
  pending
  ready
  failed

  @@map("avatar_status")
}

enum AspectRatio {
  r9_16 @map("9:16")
  r1_1  @map("1:1")
  r16_9 @map("16:9")

  @@map("aspect_ratio")
}
